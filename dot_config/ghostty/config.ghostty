# Ghostty baseline config
# Path in chezmoi: dot_config/ghostty/config.ghostty

# Theme
# You can list all built-in themes with: ghostty +list-themes
# theme = dark:Rose Pine,light:Rose Pine Dawn

# Shell
command = nu
shell-integration = nushell
shell-integration-features = no-cursor

# Font
font-family = "JetBrainsMono Nerd Font Mono"
font-size = 14

# Appearance
background-opacity = 1.0
background-opacity-cells = true
window-padding-x = 5
window-padding-y = 5
window-padding-balance = true
cursor-style = block
cursor-style-blink = true
background-blur = true

# Behavior
confirm-close-surface = false
copy-on-select = clipboard
keybind = ctrl+shift+w=close_surface

# Tabs (GTK)
window-decoration = client
window-show-tab-bar = auto
gtk-tabs-location = top
gtk-wide-tabs = false
gtk-titlebar = true
gtk-titlebar-style = native

# systemd
quit-after-last-window-closed = true
quit-after-last-window-closed-delay = 5m

# Navigation keybinds (vim-style split focus)
keybind = ctrl+shift+h=goto_split:left
keybind = ctrl+shift+j=goto_split:down
keybind = ctrl+shift+k=goto_split:up
keybind = ctrl+shift+l=goto_split:right

# Create splits quickly
keybind = ctrl+shift+backslash=new_split:right
keybind = ctrl+shift+-=new_split:down

palette = 0=#f2e9e1
palette = 1=#b4637a
palette = 2=#286983
palette = 3=#ea9d34
palette = 4=#56949f
palette = 5=#907aa9
palette = 6=#d7827e
palette = 7=#575279
palette = 8=#9893a5
palette = 9=#b4637a
palette = 10=#286983
palette = 11=#ea9d34
palette = 12=#56949f
palette = 13=#907aa9
palette = 14=#d7827e
palette = 15=#575279
background = #faf4ed
foreground = #575279
cursor-color = #575279
cursor-text = #faf4ed
selection-background = #dfdad9
selection-foreground = #575279
