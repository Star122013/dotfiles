# Ghostty baseline config
# Path in chezmoi: dot_config/ghostty/config.ghostty

# Theme
# You can list all built-in themes with: ghostty +list-themes
theme = noctalia

# Shell
command = nu
shell-integration = nushell
shell-integration-features = no-cursor

# Font
font-family = "Maple Mono NF CN"
font-size = 14

# Appearance
background-opacity = 1.0
background-opacity-cells = true
window-padding-x = 8
window-padding-y = 6
window-padding-balance = true
cursor-style = block
cursor-style-blink = true

# Behavior
confirm-close-surface = false
copy-on-select = clipboard
keybind = ctrl+shift+w=close_surface

# Tabs (GTK)
window-show-tab-bar = always
gtk-tabs-location = bottom
gtk-wide-tabs = false
gtk-toolbar-style = raised-border
gtk-custom-css = /var/home/cyrene/.config/ghostty/gtk-no-animations.css

# Navigation keybinds (vim-style split focus)
keybind = ctrl+shift+h=goto_split:left
keybind = ctrl+shift+j=goto_split:down
keybind = ctrl+shift+k=goto_split:up
keybind = ctrl+shift+l=goto_split:right

# Create splits quickly
keybind = ctrl+shift+backslash=new_split:right
keybind = ctrl+shift+-=new_split:down
