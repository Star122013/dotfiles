{
  // Left: workspaces
  "river/tags": {
    "num-tags": 5,
    "tag-labels": [
      "",
      "",
      "",
      "󰎆",
      ""
    ],
    "hide-vacant": false,
    "set-tags": [
      2147483649,
      2147483650,
      2147483652,
      2147483656,
      2147483664
    ]
  },

  // Center: now playing, styled like custom/music
  "mpris": {
    "format": "  {dynamic}",
    "format-paused": "  <i>{dynamic}</i>",
    "dynamic-order": [
      "title",
      "artist",
      "album"
    ],
    "dynamic-importance-order": [
      "title",
      "artist",
      "album",
      "position",
      "length"
    ],
    "ignored-players": [
      "firefox",
      "chromium"
    ]
  },

  // Right: system modules
  "pulseaudio#icon": {
    "format": "{icon} {volume}%",
    "format-bluetooth": "󰂯 {volume}%",
    "format-muted": "",
    "format-icons": {
      "headphone": "",
      "headset": "",
      "bluetooth": "󰂯",
      "speaker": [
        "",
        "",
        ""
      ]
    },
    "tooltip-format": "音量: {volume}%",
    "on-click": "pavucontrol",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
    "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
  },

  "backlight": {
    "format": "{icon}",
    "format-icons": [
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      ""
    ],
    "tooltip": true,
    "tooltip-format": "内屏亮度: {percent}%"
  },

  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon}",
    "format-charging": "",
    "format-plugged": "",
    "format-alt": "{icon}",
    "format-icons": [
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      ""
    ],
    "tooltip-format": "电量: {capacity}%"
  },

  "clock": {
    "interval": 60,
    "format": " {:%H:%M}",
    "format-alt": " {:%m-%d}",
    "tooltip-format": "{:%Y/%m/%d %A}",
    "on-click-middle": "gnome-clocks",
    "on-click-right": "gnome-calendar"
  },

  "tray": {
    "icon-size": 21,
    "spacing": 10
  },

  "custom/swaync": {
    "tooltip": false,
    "format": "{icon}",
    "format-icons": {
      "notification": "",
      "none": "",
      "dnd-notification": "",
      "dnd-none": "",
      "inhibited-notification": "",
      "inhibited-none": "",
      "dnd-inhibited-notification": "",
      "dnd-inhibited-none": ""
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  },

  "custom/wlogout": {
    "format": "󰐥",
    "tooltip-format": "电源菜单",
    "on-click": "wlogout"
  }
}
