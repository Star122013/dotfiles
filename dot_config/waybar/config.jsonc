		//"cffi/niri-taskbar", //需要安装waybar-niri-taskbar-git
	],
	"modules-right": [
		"tray",
		"group/ddcutil",
		"group/audio",
		"bluetooth",
		"network",
		"idle_inhibitor",
		"custom/swaync",
		"battery",
		// "power-profiles-daemon",
		"clock",
		"group/powermenu"
	]
}