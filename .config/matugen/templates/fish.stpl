# Generated by matugen

# Matugen Core Colors
set -gx background '{{colors.surface.default.hex}}'
set -gx foreground '{{colors.on_surface.default.hex}}'
set -gx cursor     '{{colors.on_surface.default.hex}}'
set -gx border     '{{colors.outline.default.hex}}'

# ANSI Colors (Material Design 3 Mapping)
# Black (Background)
set -gx color0  '{{colors.surface.default.hex}}'
# Red (Error)
set -gx color1  '{{colors.error.default.hex}}'
# Green (Primary)
set -gx color2  '{{colors.primary.default.hex}}'
# Yellow (Secondary Container)
set -gx color3  '{{colors.secondary_container.default.hex}}'
# Blue (Secondary)
set -gx color4  '{{colors.secondary.default.hex}}'
# Magenta (Tertiary)
set -gx color5  '{{colors.tertiary.default.hex}}'
# Cyan (Inverse Primary)
set -gx color6  '{{colors.inverse_primary.default.hex}}'
# White (Text)
set -gx color7  '{{colors.on_surface.default.hex}}'

# Bright Colors
# Bright Black (Surface Variant)
set -gx color8  '{{colors.surface_variant.default.hex}}'
# Bright Red
set -gx color9  '{{colors.on_error_container.default.hex}}'
# Bright Green
set -gx color10 '{{colors.primary_container.default.hex}}'
# Bright Yellow
set -gx color11 '{{colors.on_secondary.default.hex}}'
# Bright Blue
set -gx color12 '{{colors.on_secondary_container.default.hex}}'
# Bright Magenta
set -gx color13 '{{colors.on_tertiary.default.hex}}'
# Bright Cyan
set -gx color14 '{{colors.on_tertiary_container.default.hex}}'
# Bright White (Inverse Surface)
set -gx color15 '{{colors.inverse_surface.default.hex}}'

# FZF colors
# Fish handles newlines in quotes correctly
set -gx FZF_DEFAULT_OPTS "
    --style full
    --color fg:7,bg:0,hl:1,fg+:232,bg+:1,hl+:255
    --color info:7,prompt:2,spinner:1,pointer:232,marker:1
"
