# Ghostty baseline config
# Path in chezmoi: dot_config/ghostty/config.ghostty

# Theme
# You can list all built-in themes with: ghostty +list-themes

# Shell
command = nu
shell-integration = nushell
shell-integration-features = no-cursor

# Font
font-family = "JetBrainsMono Nerd Font Mono"
font-size = 14

# Appearance
background-opacity = 1.0
background-opacity-cells = true
window-padding-x = 8
window-padding-y = 6
window-padding-balance = true
cursor-style = block
cursor-style-blink = true

# Behavior
confirm-close-surface = false
copy-on-select = clipboard
keybind = ctrl+shift+w=close_surface

# Tabs (GTK)
window-show-tab-bar = auto
gtk-tabs-location = top
gtk-wide-tabs = false

# Navigation keybinds (vim-style split focus)
keybind = ctrl+shift+h=goto_split:left
keybind = ctrl+shift+j=goto_split:down
keybind = ctrl+shift+k=goto_split:up
keybind = ctrl+shift+l=goto_split:right

# Create splits quickly
keybind = ctrl+shift+backslash=new_split:right
keybind = ctrl+shift+-=new_split:down

palette = 0=#45475a
palette = 1=#f38ba8
palette = 2=#a6e3a1
palette = 3=#f9e2af
palette = 4=#89b4fa
palette = 5=#f5c2e7
palette = 6=#94e2d5
palette = 7=#a6adc8
palette = 8=#585b70
palette = 9=#f38ba8
palette = 10=#a6e3a1
palette = 11=#f9e2af
palette = 12=#89b4fa
palette = 13=#f5c2e7
palette = 14=#94e2d5
palette = 15=#bac2de
background = 1e1e2e
foreground = cdd6f4
cursor-color = f5e0dc
cursor-text = 11111b
selection-background = 353749
selection-foreground = cdd6f4
split-divider-color = 313244
