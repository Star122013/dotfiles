global {
  # tproxy port to listen on. It is NOT a HTTP/SOCKS port, and is just used by eBPF program.
  # In normal case, you do not need to use it.
  tproxy_port: 12345

  # 将其设置为 true 以保护 tproxy 端口免受未经请求的流量的影响。将其设置为 false 以允许用户使用自我管理iptables tproxy
  tproxy_port_protect: true

  log_level: warning

  # 拉取订阅前禁用等待网络（避免启动时 DNS 不通导致 dae 超时崩溃）
  disable_waiting_network: true

  # 绑定的wan口
  wan_interface: auto
  lan_interface: enp0s20f0u1

  # domain domain+ domain++ ip 四种模式
  dial_mode: domain+

  allow_insecure: false

  auto_config_kernel_parameter: true

  # 后备 DNS（系统 DNS 故障时使用 IP 直连，避免鸡生蛋问题）
  # dae 需要 DNS 来解析 upstream 域名，但 DNS 又依赖 dae 转发
  fallback_resolver: '223.5.5.5:53'

  ##### 节点连通性检查（URL 后面跟 IP 后备，避免 DNS 依赖）
  tcp_check_url: 'http://cp.cloudflare.com,1.1.1.1,2606:4700:4700::1111'
  udp_check_dns: 'dns.google:53,8.8.8.8,2001:4860:4860::8888'
  check_interval: 30s
  check_tolerance: 50ms
}
# 订阅
subscription {
  # 在下面填入你的订阅链接。
}

node {
  'socks5://127.0.0.1:2080'
}

dns {
  upstream {
    # unbound（127.0.0.1:53），处理国内域名
    local_cache: 'udp://127.0.0.1:53'
    # 国外 DNS，避免污染
    googledns: 'https://1.1.1.1/dns-query'
  }
  routing {
    request {
      # 国内域名 → unbound
      qname(geosite:cn) -> local_cache
      # 国外域名 → 直接国外 DNS，避免污染
      !qname(geosite:cn) -> googledns
      # 如果 DNS 查询是由 dae 自身发起的（subscription/node），用 bootstrap_resolver
      fallback: local_cache
    }
    response {
      # 信任 googledns 的结果
      upstream(googledns) -> accept
      # 如果响应的 IP 是私有地址且域名不是 CN，说明被污染了，重新用 googledns 查
      ip(geoip:private) && !qname(geosite:cn) -> googledns
      fallback: accept
    }
  }
}
group {
  proxy_0 {
    policy: fixed(0)
  }
}
# 参考 https://github.com/daeuniverse/dae/blob/main/docs/routing.md
routing {
  pname(dnsmasq, systemd-resolved) && l4proto(udp) && dport(53) -> must_direct
  pname(unbound) -> must_direct

  # LAN 客户端的 DNS 查询直接走 unbound，不经过 mihomo 代理
  # 必须放在 domain() 规则之前，否则 DNS 查到 google.com 会被 domain 规则匹配走代理
  l4proto(udp) && dport(53) -> direct
  pname(NetworkManager) -> direct
  pname(mihomo) -> must_direct
  pname(sing-box) -> must_direct
  pname(flclash) -> must_direct
  pname(clash) -> must_direct
  pname(clash-meta) -> must_direct

  pname(Core) -> must_direct
  pname(throne) -> must_direct
  pname(Throne) -> must_direct

  # 需要指定代理的网站或进程
  domain(suffix: github.com) -> proxy_0
  domain(suffix: ghcr.io) -> proxy_0

  # AI
  # domain(suffix: chatgpt.com) -> proxy_AI
  # domain(suffix: openai.com) -> proxy_AI
  domain(suffix: google.com) -> proxy_0

  # block
  l4proto(udp) && dport(443) -> block

  # 需要指定直连的网站或进程
  pname(qbittorrent) -> direct
  domain(suffix: deepseek.com) -> direct
  domain(suffix: firefox.com) -> direct
  domain(suffix: push.services.mozilla.com) -> direct
  domain(suffix: minecraft.net) -> direct
  domain(suffix: microsoftonline.com) -> direct
  domain(suffix: immersivetranslate.com) -> direct
  domain(full: api.bilibili.com) -> direct
  domain(suffix: bilibili.com) -> direct
  domain(suffix: archlinux.org) -> direct
  domain(suffix: cm.steampowered.com) -> direct
  domain(suffix: steamserver.net) -> direct

  dip(224.0.0.0/3, 'ff00::/8') -> direct
  dip(geoip:private) -> direct
  dip(geoip:cn) -> direct
  domain(geosite:cn) -> direct

  fallback: proxy_0
}
